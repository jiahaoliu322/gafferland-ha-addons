{
  "manifest_version": 3,
  "name": "Gafferland eTag Session",
  "version": "2.1.0",
  "description": "遠通電收會員區的 eTag 通行明細與收款憑證,由員工按「執行」時在這台電腦已登入的遠通分頁內代為查詢並產生收款憑證，交回 Gafferland 站台（平常不自動連線）。",
  "permissions": [
    "clipboardWrite",
    "cookies",
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.fetc.net.tw/*",
    "https://admin.gafferland.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
